{
  "name": "stove",

  // JDK 21 이 들어 있는 공식 이미지. Gradle 은 리포의 wrapper 를 쓰므로 따로 깔지 않는다.
  "image": "mcr.microsoft.com/devcontainers/java:21-bookworm",

  "features": {
    // 컨테이너가 자기 Docker 데몬을 갖는다.
    // Testcontainers 기반 컨텍스트 테스트와 docker compose 가 둘 다 필요하고,
    // 호스트 소켓을 마운트하는 방식(docker-outside-of-docker)은 호스트 환경을
    // 다시 가정하게 되므로 쓰지 않는다.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // Kafka·MySQL·Elasticsearch 컨테이너가 함께 뜨므로 여유를 요구한다(Codespaces 가 참고).
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },

  // Gradle 캐시를 이름 붙은 볼륨에 두어 컨테이너를 다시 만들어도 살아남게 한다.
  "mounts": [
    "source=stove-gradle-cache,target=/home/vscode/.gradle,type=volume"
  ],

  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.gradle && ./gradlew --version",

  "forwardPorts": [8080, 8081, 8082, 8083, 8084, 8085, 8086, 8087, 8088, 8089, 8090, 9200, 9090, 3000],
  "portsAttributes": {
    "8080": { "label": "gateway" },
    "8090": { "label": "kafka-ui" },
    "9200": { "label": "elasticsearch" },
    "3000": { "label": "grafana" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "java.import.gradle.wrapper.enabled": true,
        "java.configuration.updateBuildConfiguration": "automatic",
        "files.eol": "\n"
      }
    }
  },

  "remoteUser": "vscode"
}
