{
  "name": "stove",

  // JDK 21 이 들어 있는 공식 이미지. Gradle 은 리포의 wrapper 를 쓰므로 따로 깔지 않는다.
  "image": "mcr.microsoft.com/devcontainers/java:21-bookworm",

  "features": {
    // 컨테이너가 자기 Docker 데몬을 갖는다.
    //
    // docker-outside-of-docker 는 호스트의 /var/run/docker.sock 을 마운트하는데,
    // macOS + OrbStack 에서는 그 경로가 admin 권한으로만 생긴다. 빌려 쓰는 머신에서
    // 기대할 수 없는 조건이라, 호스트를 전혀 가정하지 않는 이쪽을 쓴다.
    //
    // Docker 버전을 고정한다. feature 기본값(latest)은 29 를 설치하는데,
    // Docker 29 가 구 API 지원을 끊어서 Testcontainers 1.21(Spring Boot 3.5 가 관리하는
    // 버전)의 초기 핑이 거부됐다:
    //   "client version 1.32 is too old. Minimum supported API version is 1.40"
    //
    // 그 조건은 이미 해소됐다 — gradle.properties 가 testcontainersVersion 을 1.21.4 로
    // 올렸고, CI 러너는 Docker 28.1.1 위에서 그대로 돈다. 고정을 풀 수 있다는 뜻이지만
    // **이 경로로 검증한 적이 없어서 그대로 둔다.** 28 은 지금도 맞는 값이고,
    // 푸는 변경은 devcontainer 를 실제로 띄워 확인한 다음에 한다.
    // 돌지 않은 검사는 통과한 것이 아니다(decisions.md 12번).
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "28"
    }
  },

  // Kafka·MySQL·Elasticsearch 컨테이너가 함께 뜨므로 여유를 요구한다(Codespaces 가 참고).
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },

  "mounts": [
    // Gradle 캐시. 컨테이너를 다시 만들어도 살아남는다.
    "source=stove-gradle-cache,target=/home/vscode/.gradle,type=volume",

    // 안쪽 Docker 데몬의 이미지 저장소.
    //
    // 중첩 Docker 의 실질적 비용은 "격리" 자체가 아니라 호스트 이미지 캐시를 못 쓴다는
    // 점이다. 이걸 안 두면 컨테이너를 다시 만들 때마다 MySQL·Kafka·ES·Mongo·MinIO 를
    // 안쪽에서 새로 받는다(2GB+). 볼륨으로 빼두면 그 비용을 머신당 한 번만 낸다.
    "source=stove-dind-cache,target=/var/lib/docker,type=volume"
  ],

  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.gradle && ./gradlew --version",

  "forwardPorts": [8080, 8081, 8082, 8083, 8084, 8085, 8086, 8087, 8088, 8089, 8090, 9200, 9090, 3000],
  "portsAttributes": {
    "8080": { "label": "gateway" },
    "8090": { "label": "kafka-ui" },
    "9200": { "label": "elasticsearch" },
    "3000": { "label": "grafana" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "java.import.gradle.wrapper.enabled": true,
        "java.configuration.updateBuildConfiguration": "automatic",
        "files.eol": "\n"
      }
    }
  },

  "remoteUser": "vscode"
}
