# direnv 설정. 값을 박지 않고 매번 계산하므로 작업 머신이 바뀌어도 그대로 쓴다.
#
#   direnv allow     # 새 머신에서 한 번 (내용을 확인했다는 서명)

# ── Docker ────────────────────────────────────────────────────────────
# OrbStack 은 CLI 를 앱 번들 안에 둔다. Docker Desktop/Colima 면 이미 PATH 에 있다.
if [ -d /Applications/OrbStack.app/Contents/MacOS/xbin ]; then
    PATH_add /Applications/OrbStack.app/Contents/MacOS/xbin
fi

# 활성 docker 컨텍스트에서 소켓 주소를 뽑는다.
# Testcontainers 는 DOCKER_HOST 를 ~/.testcontainers.properties 보다 먼저 보므로,
# 그 파일에 머신별 절대경로를 적어둘 필요가 없다.
if command -v docker >/dev/null 2>&1; then
    docker_endpoint="$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null)"
    [ -n "$docker_endpoint" ] && export DOCKER_HOST="$docker_endpoint"
    unset docker_endpoint
fi

# ── JDK ───────────────────────────────────────────────────────────────
# mise/asdf 가 있으면 .mise.toml 을 보고 알아서 잡아준다.
# 없는 환경을 위한 최소한의 대비만 둔다.
if [ -z "$JAVA_HOME" ] && command -v /usr/libexec/java_home >/dev/null 2>&1; then
    JAVA_HOME="$(/usr/libexec/java_home -v 21 2>/dev/null)" && export JAVA_HOME
fi

# 머신 고유 설정이 필요하면 .envrc.local 에 둔다(gitignore 대상).
[ -f .envrc.local ] && source_env .envrc.local
