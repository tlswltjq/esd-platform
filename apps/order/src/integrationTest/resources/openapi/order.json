            "format" : "int32",
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseAdminRefundPage"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "oauth2" : [ "commerce" ]
        } ],
        "summary" : "관리자 환불 목록",
        "tags" : [ "admin-refund-controller" ]
      }
    },
