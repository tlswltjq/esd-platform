        "parameters" : [ {
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "default" : "PENDING_REVIEW",
            "enum" : [ "PENDING_REVIEW", "PENDING_APPROVAL_STOP", "PENDING_LICENSE_GRANT", "PENDING_LICENSE_SUSPENSION", "PENDING_PAYMENT_REFUND", "PENDING_LICENSE_RESTORATION", "FAILED", "REJECTED", "COMPLETED" ],
            "type" : "string"
          }
        }, {
