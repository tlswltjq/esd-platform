{
  "components" : {
    "schemas" : {
      "ApiResponsePaymentResponse" : {
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/PaymentResponse"
          },
          "error" : {
            "$ref" : "#/components/schemas/ErrorBody"
          },
          "success" : {
            "type" : "boolean"
          }
        },
        "type" : "object"
      },
      "ApiResponsePreparePaymentResponse" : {
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/PreparePaymentResponse"
          },
          "error" : {
            "$ref" : "#/components/schemas/ErrorBody"
          },
          "success" : {
            "type" : "boolean"
          }
        },
        "type" : "object"
      },
      "ApiResponseVoid" : {
        "properties" : {
          "data" : { },
          "error" : {
            "$ref" : "#/components/schemas/ErrorBody"
          },
          "success" : {
            "type" : "boolean"
          }
        },
        "type" : "object"
      },
      "Approved" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/PgCallbackRequest"
        }, {
          "properties" : {
            "idempotencyKey" : {
              "minLength" : 1,
              "type" : "string"
            },
            "method" : {
              "type" : "string"
            },
            "orderNo" : {
              "minLength" : 1,
              "type" : "string"
            },
            "paidAmount" : {
              "format" : "int64",
              "type" : "integer"
            },
            "pgTxId" : {
              "minLength" : 1,
              "type" : "string"
            }
          },
          "type" : "object"
        } ],
        "required" : [ "idempotencyKey", "orderNo", "paidAmount", "pgTxId" ]
      },
      "Declined" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/PgCallbackRequest"
        }, {
          "properties" : {
            "orderNo" : {
              "minLength" : 1,
              "type" : "string"
            },
            "pgTxId" : {
              "minLength" : 1,
              "type" : "string"
            },
            "reason" : {
              "type" : "string"
            },
            "reasonCode" : {
              "minLength" : 1,
              "type" : "string"
            }
          },
          "type" : "object"
        } ],
        "required" : [ "orderNo", "pgTxId", "reasonCode" ]
      },
      "ErrorBody" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PaymentResponse" : {
        "properties" : {
          "amount" : {
            "format" : "int64",
            "type" : "integer"
          },
          "currency" : {
            "type" : "string"
          },
          "memberId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "method" : {
            "type" : "string"
          },
          "orderNo" : {
            "type" : "string"
          },
          "paidAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "paymentId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "pgTxId" : {
            "type" : "string"
          },
          "status" : {
            "enum" : [ "READY", "PENDING", "PAID", "CANCELING", "CANCELED", "FAILED" ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PgCallbackRequest" : {
        "discriminator" : {
          "propertyName" : "result"
        },
        "properties" : {
          "result" : {
            "type" : "string"
          }
        },
        "required" : [ "result" ]
      },
      "PreparePaymentRequest" : {
        "properties" : {
          "method" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "method" ],
        "type" : "object"
      },
      "PreparePaymentResponse" : {
        "properties" : {
          "amount" : {
            "format" : "int64",
            "type" : "integer"
          },
          "currency" : {
            "type" : "string"
          },
          "orderNo" : {
            "type" : "string"
          },
          "pgTxId" : {
            "type" : "string"
          },
          "redirectUrl" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "모든 응답은 공통 봉투 `{success, data, error}` 로 감싼다.\n실패면 `success=false` 이고 `error.code` 에 `ErrorCode` 이름이 들어간다\n(`PRICE_MISMATCH`, `PAYMENT_AMOUNT_MISMATCH` 등). HTTP 상태는 그 코드가 정한다.\n\n`data` 가 없는 성공 응답(`ApiResponse.ok()`)에서는 `data` 필드 자체가 빠진다 —\n봉투에 `@JsonInclude(NON_NULL)` 이 걸려 있다.",
    "title" : "STOVE payment API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/payments/callback" : {
      "post" : {
        "operationId" : "callback",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "oneOf" : [ {
                  "$ref" : "#/components/schemas/Approved"
                }, {
                  "$ref" : "#/components/schemas/Declined"
                } ]
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseVoid"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "payment-controller" ]
      }
    },
    "/api/v1/payments/{orderNo}" : {
      "get" : {
        "operationId" : "get",
        "parameters" : [ {
          "in" : "path",
          "name" : "orderNo",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponsePaymentResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "payment-controller" ]
      }
    },
    "/api/v1/payments/{orderNo}/cancel" : {
      "post" : {
        "operationId" : "cancel",
        "parameters" : [ {
          "in" : "path",
          "name" : "orderNo",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "reason",
          "required" : false,
          "schema" : {
            "default" : "USER_REFUND",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseVoid"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "payment-controller" ]
      }
    },
    "/api/v1/payments/{orderNo}/prepare" : {
      "post" : {
        "operationId" : "prepare",
        "parameters" : [ {
          "in" : "path",
          "name" : "orderNo",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PreparePaymentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponsePreparePaymentResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "payment-controller" ]
      }
    }
  }
}
