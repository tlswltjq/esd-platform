# PortOne V2 test integration preparation.
# Copy to the repository root as .env.portone-test and fill in locally.
# Current applications do not load this file automatically.
# Store ID and channel key: PortOne console > payment integration > integration management.
# API secret: identification codes / API Keys > V2 API.
# Use the PortOne V2 API Secret, not the PG API Key shown in channel settings.
# The selected channel must be a test channel.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_WEBHOOK_URL=
