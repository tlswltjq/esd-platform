.gradle/
__pycache__/
build/
# Studio의 빌드 업무 패키지는 Gradle 빌드 산출물이 아닌 소스다.
!apps/studio/src/**/core/domain/build/
!apps/studio/src/**/core/service/build/
!gradle/wrapper/gradle-wrapper.jar
out/
bin/

.idea/
*.iml
*.ipr
*.iws
.vscode/
.claude/settings.local.json
.DS_Store

*.log
logs/
.env

# 측정 결과. 회차마다 CSV 가 수천 줄씩 쌓이고, 값이 있는 것은 원본이 아니라
# 그 결과는 저장소에 넣지 않는다.
perf-results/

# 검증·실험 회차 산출물
runs/

# 에이전트 작업 공간 — 워크트리와 세션 설정. 리포에 담을 것이 아니다.
.claude/
